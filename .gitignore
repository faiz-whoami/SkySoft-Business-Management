# ASP.NET Core
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# Visual Studio cache directory
.vs/

# Resharper is Java-based, but may interfere
_ReSharper*/
*.resharper
*.ReSharper

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*.json

# Build logs
*.log

# NuGet Packages
*.nupkg
*.snupkg
# NuGet.Config
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if necessary however generally it should be regenerated when needed
#!**/packages/repositories.config
# NuGet v3's project.json files makes some windows builds fail.
project.json
project.lock.json

# Visual Studio misc files
*.sln.rej

# Publish Web Output
[Pp]ublish[Rr]esults/
[Pp]ublished[Ww]ebsites/
*.PublishSettings
*.pubxml
*.resx
*.pfx
*.publishproj

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# checkin your publish settings, but sensitive information should be stored
# in secrets or environment variables.
PublishSettings/
*.azurePubxml

# Local database file from Entity Framework
*.mdf
*.ldf

# Backup & temp files
*.bak
*.tmp
*.~*
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Application Insights
ApplicationInsights.config
AppInsightsResources/

# Local user secrets
[Uu]ser[Ss]ecrets/
secrets.json
secrets.*.json

# Azure Storage emulator
__blobstorage__
__queuestorage__

# Entity Framework Core Migration Files
**/Migrations/

# User-specific secrets and configuration
appsettings.Local.json

# Crystal Reports specific
*.rpt
*.rpts
*.rptxx
*.rptproj

# Build folder
build/
dist/

# Coverage reports
coverage/
codecov.yml

# Temporary test files
temp/
*.tmp
.temp/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Node modules (if using npm)
node_modules/
npm-debug.log
yarn-error.log

# Dependencies and runtime
lib/
out/
bin/
obj/

# Test Results
TestResults/
*.trx

# Coverage files
*.coverage
coverage.json
opencover.xml

# Report files
report/

# Rider
.idea/
**.sln.iml

# Local environment files
.env
.env.local
.env.*.local

# Angular build
dist/
npm-debug.log

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# ReSharper cache
_ReSharper*/

# Deployment-related files
publish/
PublishProfiles/

# Database migration backups
Backups/

# FxCop results
FxCopResults.csv

# Exclude visual studio database projects
*.dbmdl
*.dbproj.vspscc

# Code Analysis Results
/StyleCopReport.xml

# Roslyn analyzers
.roslyn/

# Exclude Database directory if not part of version control
Database/Backups/
Database/*.bak

# Exclude sensitive application configuration
*.ConnectionStrings.json

# Temporary files and folders
.tmp/
temp/
