@model business_managment_system.Models.ProductListViewModel
@{
    ViewBag.Title = "Products";
    var canManage = User.IsInRole("Admin");
}

<div class="page-toolbar">
    <div>
        <h2 class="dash-title mb-0">Products</h2>
    </div>
    @if (canManage)
    {
        <a class="btn btn-primary" href="@Url.Action("Create")"><i class="bi bi-plus-lg"></i> New product</a>
    }
</div>

<div class="card-panel mb-3">
    @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "filter-bar" }))
    {
        <div class="filter-field">
            <label class="form-label" for="search">Search</label>
            @Html.TextBoxFor(m => m.Search, new { @class = "form-control", id = "search", placeholder = "Name or SKU..." })
        </div>
        <div class="filter-field filter-field--status">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="active" @(Model.Status == "active" ? "selected" : null)>Active</option>
                <option value="inactive" @(Model.Status == "inactive" ? "selected" : null)>Inactive</option>
                <option value="all" @(Model.Status == "all" ? "selected" : null)>All</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Apply</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Reset</a>
        </div>
    }
</div>

<div class="card-panel">
    @if (Model.Items != null && Model.Items.Count > 0)
    {
        <div class="panel-head">
            <p class="page-lead mb-0">@(Model.Items.Count) product@(Model.Items.Count == 1 ? "" : "s")</p>
        </div>
    }
    @if (Model.Items == null || Model.Items.Count == 0)
    {
        <div class="table-empty">No products match this filter.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table mb-0">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th class="text-end">Unit price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="mono">@(string.IsNullOrWhiteSpace(item.Sku) ? "-" : item.Sku)</td>
                            <td>
                                <a class="table-link" href="@Url.Action("Details", new { id = item.ProductId })">@item.ProductName</a>
                            </td>
                            <td class="text-end fw-semibold">$@item.UnitPrice.ToString("N2")</td>
                            <td>
                                <span class="badge-status @(item.IsActive ? "badge-status--completed" : "badge-status--cancelled")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", new { id = item.ProductId })">View</a>
                                @if (canManage)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.ProductId })">Edit</a>
                                    <form action="@Url.Action("ToggleStatus")" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.ProductId)
                                        @Html.Hidden("search", Model.Search)
                                        @Html.Hidden("status", Model.Status)
                                        <button class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                type="submit"
                                                onclick="return confirm('@(item.IsActive ? "Deactivate this product? It will be hidden from new transactions." : "Reactivate this product?")');">
                                            @(item.IsActive ? "Deactivate" : "Reactivate")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
