@model business_managment_system.Models.ReportIndexViewModel
@{
    ViewBag.Title = "Reports";
}

<div class="page-toolbar">
    <div>
        <p class="dash-kicker">Operations</p>
        <h2 class="dash-title mb-0">Reports</h2>
        <p class="page-lead mb-0">Each report downloads as a PDF. Empty results stay on this page with a message.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-panel h-100 report-card">
            <p class="dash-kicker">FR-REPT-01</p>
            <h2 class="h5">Business Partner Directory</h2>
            <p class="page-lead">Active customers, suppliers, and vendors, grouped by type.</p>
            @using (Html.BeginForm("PartyDirectory", "Report", FormMethod.Get))
            {
                <label class="form-label" for="partyType">Party type</label>
                <select class="form-select mb-3" id="partyType" name="partyType">
                    <option value="">All partners</option>
                    <option value="Customer" @(Model.PartyType == "Customer" ? "selected" : null)>Customers</option>
                    <option value="Supplier" @(Model.PartyType == "Supplier" ? "selected" : null)>Suppliers</option>
                    <option value="Vendor" @(Model.PartyType == "Vendor" ? "selected" : null)>Vendors</option>
                </select>
                <button class="btn btn-primary" type="submit"><i class="bi bi-file-earmark-pdf"></i> Open PDF</button>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-panel h-100 report-card">
            <p class="dash-kicker">FR-REPT-02</p>
            <h2 class="h5">Transaction Detail Statement</h2>
            <p class="page-lead">One transaction with line items, party, and recorded-by.</p>
            @using (Html.BeginForm("TransactionDetail", "Report", FormMethod.Get))
            {
                <label class="form-label" for="id">Transaction ID</label>
                <input class="form-control mb-3" id="id" name="id" type="number" min="1" value="@(Model.TransactionId.HasValue ? Model.TransactionId.Value.ToString() : "")" placeholder="e.g. 1" />
                <button class="btn btn-primary" type="submit"><i class="bi bi-file-earmark-pdf"></i> Open PDF</button>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-panel h-100 report-card">
            <p class="dash-kicker">FR-REPT-03</p>
            <h2 class="h5">Monthly Transaction Summary</h2>
            <p class="page-lead">Counts and totals by year, month, and type.</p>
            @using (Html.BeginForm("MonthlySummary", "Report", FormMethod.Get))
            {
                <label class="form-label" for="year">Year</label>
                <select class="form-select mb-3" id="year" name="year">
                    <option value="">All years</option>
                    @foreach (var year in Model.Years)
                    {
                        <option value="@year" @(Model.Year == year ? "selected" : null)>@year</option>
                    }
                </select>
                <button class="btn btn-primary" type="submit"><i class="bi bi-file-earmark-pdf"></i> Open PDF</button>
            }
        </div>
    </div>
</div>
