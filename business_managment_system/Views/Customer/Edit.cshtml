@model business_managment_system.Models.CustomerFormViewModel
@{
    ViewBag.Title = "Edit customer";
}

<div class="page-toolbar">
    <div>
        <h2 class="dash-title mb-0">Edit customer</h2>
    </div>
    <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.CustomerId })">Cancel</a>
</div>

<div class="card-panel form-panel">
    @using (Html.BeginForm("Edit", "Customer", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CustomerId)
        @Html.Partial("_Form", Model)
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.CustomerId })">Cancel</a>
        </div>
    }
</div>
