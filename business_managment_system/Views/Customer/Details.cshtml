@model business_managment_system.Models.CustomerDetailsViewModel
@{
    var customer = Model.Customer;
    ViewBag.Title = customer.Name;
}

<div class="page-toolbar">
    <div>
        <h2 class="dash-title mb-0">@customer.Name</h2>
        <p class="page-lead mb-0">
            <span class="badge-status @(customer.IsActive ? "badge-status--completed" : "badge-status--cancelled")">
                @(customer.IsActive ? "Active" : "Inactive")
            </span>
        </p>
    </div>
    <div class="toolbar-actions">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Back to list</a>
        <a class="btn btn-primary" href="@Url.Action("Edit", new { id = customer.CustomerId })">Edit</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card-panel h-100">
            <h2 class="h6 text-uppercase text-muted mb-3">Contact</h2>
            <dl class="detail-list">
                <dt>Email</dt>
                <dd>@(string.IsNullOrWhiteSpace(customer.Email) ? "-" : customer.Email)</dd>
                <dt>Phone</dt>
                <dd>@(string.IsNullOrWhiteSpace(customer.Phone) ? "-" : customer.Phone)</dd>
                <dt>Address</dt>
                <dd>@(string.IsNullOrWhiteSpace(customer.Address) ? "-" : customer.Address)</dd>
                <dt>Created</dt>
                <dd>@customer.CreatedDate.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card-panel h-100">
            <h2 class="h6 text-uppercase text-muted mb-3">Transactions</h2>
            @if (Model.Transactions == null || Model.Transactions.Count == 0)
            {
                <div class="table-empty">No sales have been recorded for this customer yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Transactions)
                            {
                                <tr>
                                    <td class="mono">#@row.TransactionId</td>
                                    <td>@row.TransactionDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge-type badge-type--@((row.TransactionType ?? "").ToLowerInvariant())">@row.TransactionType</span></td>
                                    <td><span class="badge-status badge-status--@((row.Status ?? "").ToLowerInvariant())">@row.Status</span></td>
                                    <td class="text-end fw-semibold">$@row.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
