@model business_managment_system.Models.TransactionCreateViewModel
@{
    ViewBag.Title = "New transaction";
}

<div class="page-toolbar">
    <div>
        <h2 class="dash-title mb-0">New transaction</h2>
    </div>
    <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Back to list</a>
</div>

<div class="card-panel">
    @using (Html.BeginForm("Create", "Transaction", FormMethod.Post, new { id = "txn-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ItemsJson)

        <div class="row">
            <div class="col-md-4 mb-3">
                @Html.LabelFor(m => m.TransactionTypeName, new { @class = "form-label" })
                <select class="form-select" id="TransactionTypeName" name="TransactionTypeName" data-selected="@Model.TransactionTypeName"></select>
                @Html.ValidationMessageFor(m => m.TransactionTypeName, "", new { @class = "field-validation-error" })
            </div>
            <div class="col-md-5 mb-3">
                <label class="form-label" for="PartyId" id="party-label">Party</label>
                <select class="form-select" id="PartyId" name="PartyId" data-selected="@Model.PartyId"></select>
                @Html.ValidationMessageFor(m => m.PartyId, "", new { @class = "field-validation-error" })
            </div>
            <div class="col-md-3 mb-3">
                @Html.LabelFor(m => m.TransactionDate, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.TransactionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.TransactionDate, "", new { @class = "field-validation-error" })
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 text-uppercase text-muted mb-0">Line items</h2>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="txn-add-line"><i class="bi bi-plus-lg"></i> Add line</button>
        </div>
        <p class="field-validation-error" id="txn-lines-error" hidden></p>
        <div class="table-responsive">
            <table class="table data-table mb-0" id="txn-grid">
                <thead>
                    <tr>
                        <th style="min-width: 220px;">Product</th>
                        <th>Description</th>
                        <th class="text-end" style="width: 110px;">Qty</th>
                        <th class="text-end" style="width: 130px;">Unit price</th>
                        <th class="text-end" style="width: 130px;">Line total</th>
                        <th style="width: 90px;"></th>
                    </tr>
                </thead>
                <tbody id="txn-lines"></tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end text-muted">Total</td>
                        <td class="text-end fw-semibold" id="txn-grand-total">$0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="form-actions mt-3">
            <button class="btn btn-primary" type="submit">Save transaction</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancel</a>
        </div>
    }
</div>

<script type="application/json" id="txn-catalog">@Html.Raw(Model.CatalogJson)</script>

@section scripts {
    <script src="~/Scripts/transactions.js"></script>
}
