@model business_managment_system.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Sign in";
}
<div class="login-wrap">
    <div class="login-card">
        <div class="brand login-brand">
            <span class="brand-mark">S</span>
            <div>
                <div class="brand-name">SkySoft Business Management</div>
                <div class="brand-sub">Sign in to continue</div>
            </div>
        </div>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("returnUrl", (string)ViewBag.ReturnUrl)

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-validation-error" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
        }
    </div>
</div>
